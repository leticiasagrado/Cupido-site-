# Copie para .env no servidor e preencha. Nunca envie o .env para o GitHub.
DOMAIN=cupidbureau.site
PB_DOMAIN=admin.cupidbureau.site

# Conta técnica do PocketBase (painel em https://admin.cupidbureau.site/_/)
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# 32 caracteres aleatórios. Gere com: openssl rand -hex 16
PB_ENCRYPTION_KEY=

# Opcional: cria admin@cupidbureau.site numa instalação nova
ADMIN_INITIAL_PASSWORD=
